# Copy to `.env` for local development. Never commit `.env`.
# Every variable is prefixed `dizzy_gals_`; plain DATABASE_URL is ignored.

# Postgres connection string. These are the names the Vercel × Prisma Postgres
# integration sets; either one works (the first one set wins).
dizzy_gals_PRISMA_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
dizzy_gals_POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Password for /admin. Any long random string.
dizzy_gals_ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie, e.g. `openssl rand -hex 32`.
# Changing it signs every admin out.
dizzy_gals_ADMIN_SESSION_SECRET="change-me-too"

# Resend (https://resend.com) for order confirmations and the newsletter
# welcome email. Leave unset to skip email (a log line says so).
dizzy_gals_RESEND_API_KEY="re_..."
# Must be on a domain verified in Resend. Defaults to "Dizzy Gals <hello@dizzygals.com>".
dizzy_gals_EMAIL_FROM="Dizzy Gals <hello@dizzygals.com>"
# Optional: an inbox that gets a copy of every new order.
dizzy_gals_ORDER_NOTIFY_EMAIL=""
