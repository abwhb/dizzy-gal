# Copy to `.env` for local development. Never commit `.env`.
# Every variable is prefixed `dizzy_gals_`; plain DATABASE_URL / RESEND_API_KEY
# are ignored so another project's settings can't leak in.

# Postgres connection string. These are the names the Vercel × Prisma Postgres
# integration sets; either one works (the first one set wins).
dizzy_gals_PRISMA_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
dizzy_gals_POSTGRES_URL=

# /admin sign-in. Any long random strings; the secret signs the session cookie
# (`openssl rand -hex 32`) and changing it signs every admin out.
dizzy_gals_ADMIN_PASSWORD="change-me"
dizzy_gals_ADMIN_SESSION_SECRET="change-me-too"

# Resend (https://resend.com) for order, wholesale and newsletter email, sent
# from mail.dizzygals.com. Without a key every send is a logged no-op, so local
# dev and previews never email anyone by accident. `dizzy_gals_RESEND` is
# accepted as an alias.
dizzy_gals_RESEND_API_KEY=

# Where the site's transactional email goes. Defaults shown.
dizzy_gals_ORDERS_NOTIFY_EMAIL=hello@dizzygals.com
dizzy_gals_WHOLESALE_NOTIFY_EMAIL=wholesale@dizzygals.com

# Canonical origin for links in emails, canonicals, the sitemap and structured
# data. Falls back to Vercel's production URL, then localhost. (Next.js needs
# the NEXT_PUBLIC_ prefix for this one.)
NEXT_PUBLIC_SITE_URL=
