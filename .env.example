# Copy to .env.local for local development. All optional.

# Resend API key. Without it, orders and enquiries still go through but no
# email is sent (the server logs a warning instead) — so previews and local
# dev never email anyone by accident. Emails send from mail.dizzygals.com.
RESEND_API_KEY=

# Where the site's transactional email goes. Defaults shown.
ORDERS_NOTIFY_EMAIL=hello@dizzygals.com
WHOLESALE_NOTIFY_EMAIL=wholesale@dizzygals.com

# Canonical origin for links in emails, canonicals, the sitemap and
# structured data. Falls back to Vercel's production URL, then localhost.
NEXT_PUBLIC_SITE_URL=
